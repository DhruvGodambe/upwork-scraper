# Upwork credentials. Never commit your real .env file.
UPWORK_USERNAME=your-email@example.com
# Optional for Google- or Apple-linked accounts; complete login in the visible browser instead.
UPWORK_PASSWORD=

# Required profile setting used to isolate the job-results text
UPWORK_FIRST_NAME=YourFirstName

# Optional settings
UPWORK_DATABASE_PATH=upwork_jobs.db
BROWSER_EXECUTABLE_PATH=
UPWORK_PROXY_SERVER=
UPWORK_DRIVER_CACHE_DIR=~/.cache/upwork-scraper
UPWORK_BROWSER_PROFILE_DIR=~/.local/state/upwork-scraper/chrome-profile
UPWORK_VERIFICATION_TIMEOUT=120
LOG_LEVEL=INFO
